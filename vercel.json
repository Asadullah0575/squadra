{
  "version": 2,
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/index.html", "status": 301, "dest": "/app" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/", "dest": "/landing.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}